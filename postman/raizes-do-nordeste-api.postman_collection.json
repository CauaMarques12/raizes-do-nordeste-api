          "name": "Consultar historico fidelidade",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "url": "{{base_url}}/fidelidade/historico?page=1&limit=10"
          }
        },
        {
          "name": "Resgatar pontos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pontos\": 1\n}"
            },
            "url": "{{base_url}}/fidelidade/resgates"
          }
        },
        {
          "name": "Status EM_PREPARO",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
