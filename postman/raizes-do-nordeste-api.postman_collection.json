              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PRONTO\"\n}"
            },
            "url": "{{base_url}}/pedidos/{{order_id}}/status"
