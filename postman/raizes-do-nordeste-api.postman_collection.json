          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unidade Postman\",\n  \"address\": \"Rua do Teste 123\",\n  \"city\": \"Recife\",\n  \"state\": \"PE\"\n}"
            },
            "url": "{{base_url}}/unidades"
          }
        },
        {
          "name": "Listar unidades paginado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "url": "{{base_url}}/unidades?page=1&limit=10"
          }
        },
        {
          "name": "Criar produto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('product_id', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cuscuz Postman\",\n  \"description\": \"Produto criado pela collection\",\n  \"category\": \"comida\",\n  \"priceCents\": 2000\n}"
            },
            "url": "{{base_url}}/produtos"
          }
        },
        {
          "name": "Listar produtos paginado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "url": "{{base_url}}/produtos?category=comida&page=1&limit=10"
          }
        },
        {
          "name": "Entrada de estoque",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": \"{{unit_id}}\",\n  \"produtoId\": \"{{product_id}}\",\n  \"tipo\": \"ENTRADA\",\n  \"quantidade\": 5,\n  \"motivo\": \"entrada inicial postman\"\n}"
            },
            "url": "{{base_url}}/estoque/movimentacoes"
          }
        },
        {
          "name": "Consultar estoque",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/estoque?unidadeId={{unit_id}}&produtoId={{product_id}}"
          }
        },
        {
          "name": "Consultar cardapio por unidade",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "url": "{{base_url}}/unidades/{{unit_id}}/cardapio?category=comida&page=1&limit=10"
          }
        },
        {
          "name": "Criar promocao",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('promo_code', `PROMO${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('promotion_id', data.id);",
                  "pm.collectionVariables.set('promo_code', data.code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Promocao Postman\",\n  \"code\": \"{{promo_code}}\",\n  \"discountPercent\": 25,\n  \"active\": true\n}"
            },
            "url": "{{base_url}}/promocoes"
          }
        },
        {
          "name": "Listar promocoes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "url": "{{base_url}}/promocoes?active=true&page=1&limit=10"
          }
        }
      ]
    },
    {
      "name": "03 - Pedido, pagamento e fidelidade",
      "item": [
        {
          "name": "Criar pedido com promocao",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('order_id', data.id);",
                  "pm.collectionVariables.set('order_total', data.totalCents);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"APP\",\n  \"clienteId\": \"{{client_id}}\",\n  \"unidadeId\": \"{{unit_id}}\",\n  \"formaPagamento\": \"MOCK\",\n  \"codigoPromocao\": \"{{promo_code}}\",\n  \"itens\": [\n    {\n      \"produtoId\": \"{{product_id}}\",\n      \"quantidade\": 2\n    }\n  ]\n}"
            },
            "url": "{{base_url}}/pedidos"
          }
        },
        {
          "name": "Listar pedidos por canal",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/pedidos?canalPedido=APP&page=1&limit=10"
          }
        },
        {
          "name": "Buscar pedido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "url": "{{base_url}}/pedidos/{{order_id}}"
          }
        },
        {
          "name": "Pagamento aprovado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('payment_id', data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedidoId\": \"{{order_id}}\",\n  \"valorCents\": {{order_total}},\n  \"aprovado\": true\n}"
            },
            "url": "{{base_url}}/pagamentos"
          }
        },
        {
          "name": "Buscar pagamento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "url": "{{base_url}}/pagamentos/{{payment_id}}"
          }
        },
        {
          "name": "Listar pagamentos do pedido",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "url": "{{base_url}}/pagamentos?pedidoId={{order_id}}&page=1&limit=10"
          }
        },
        {
          "name": "Consultar saldo fidelidade",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "url": "{{base_url}}/fidelidade/saldo"
          }
        },
